/* Import alert: Keynote or PowerPoint could not export the slides. */ "The slides could not be exported. You can also export the presentation as PDF from the app that made it." = "No se pudieron exportar las diapositivas. También puedes exportar la presentación como PDF desde la app con la que se hizo.";
/* Import progress sheet title: %@ is the presentation's file name. */ "Importing “%@”" = "Importando “%@”";
/* Import progress sheet: while Keynote or PowerPoint exports the slides. */ "Exporting the slides…" = "Exportando las diapositivas…";
/* Import progress sheet: the first %ld is the slide being imported, the second the number of slides. */ "Importing slide %ld of %ld" = "Importando diapositiva %ld de %ld";
/* Media bin: the kind of a still image file. */ "Image" = "Imagen";
/* Media bin: size of an image or video in pixels; %1$ld is the width and %2$ld the height. */ "%1$ld × %2$ld" = "%1$ld × %2$ld";
/* Media bin caption: %1$@ is the kind (Image) and %2$@ the size in pixels. */ "%1$@ · %2$@" = "%1$@ · %2$@";
/* Media bin caption: %1$@ is the kind (Video), %2$@ its length and %3$@ its size in pixels. */ "%1$@ · %2$@ · %3$@" = "%1$@ · %2$@ · %3$@";
/* Alert title after an import where some files were not added. */ "Some files could not be added." = "Algunos archivos no se pudieron agregar.";
/* Alert text after an import; %@ is the list of file names, one per line. */ "These files are not images or videos, or could not be read:\n%@" = "Estos archivos no son imágenes ni videos, o no se pudieron leer:\n%@";
/* Live drawer tab that shows the slide grid. */ "Slides" = "Diapositivas";
/* Live drawer tab and heading of the library's images and videos. */ "Images & Videos" = "Imágenes y videos";
/* Media bin filter that shows every image and video. */ "All" = "Todo";
/* Media bin filter that shows only images. */ "Images" = "Imágenes";
/* Media bin filter that shows only videos. */ "Videos" = "Videos";
/* Media bin: placeholder of the search field, which looks at file names only. */ "Search media names" = "Buscar por nombre";
/* Media bin button (Shift-Command-I) that copies images and videos into the library. */ "Import…" = "Importar…";
/* Media bin: shown next to the filters while files are copied into the library. */ "Importing…" = "Importando…";
/* Media bin empty state: title when the library has no images or videos. */ "No images or videos yet" = "Todavía no hay imágenes ni videos";
/* Media bin empty state: how to add the first images and videos. */ "Drag your images and videos here, or click Import…" = "Arrastra aquí tus imágenes y videos, o haz clic en Importar…";
/* Media bin: shown when no image or video matches the filter and the search. */ "No images or videos match your search." = "Ninguna imagen ni video coincide con tu búsqueda.";
/* Media bin: label on the image or video that is the background on the outputs now. */ "On screen" = "En pantalla";
/* On screen line: the background part when it is a color; %@ is the color as #RRGGBB. */ "Background: %@ (color)" = "Fondo: %@ (color)";
/* On screen line: the background part when it is an image; %@ is its name. */ "Background: %@ (image)" = "Fondo: %@ (imagen)";
/* On screen line: the background part when it is a video; %@ is its name. */ "Background: %@ (video, muted, looping)" = "Fondo: %@ (video, sin sonido, en bucle)";
/* On screen line above the outputs: lyrics over a background; %1$@ is the part, such as Chorus · 2 of 2, and %2$@ the background part. */ "On screen: Lyrics · %1$@ · %2$@" = "En pantalla: Letra · %1$@ · %2$@";
/* On screen line above the outputs: the lyrics are cleared and a background shows; %@ is the background part. */ "On screen: %@ · no lyrics (cleared; Next shows them again)" = "En pantalla: %@ · sin letra (borrada; Siguiente la vuelve a mostrar)";
/* On screen line above the outputs: lyrics with no background; %@ is the part, such as Chorus · 2 of 2. */ "On screen: Lyrics · %@ · no background (black behind the lyrics)" = "En pantalla: Letra · %@ · sin fondo (negro detrás de la letra)";
/* On screen line above the outputs: no lyrics and no background. */ "On screen: Nothing · the audience screens are black" = "En pantalla: Nada · las pantallas del público están en negro";
